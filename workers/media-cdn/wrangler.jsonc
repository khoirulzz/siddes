{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "subwebdes-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "CLOUDINARY_CLOUD_NAME": "dcf6mkq3q"
  },
  "routes": [
    {
      "pattern": "cdn.desalambanggelun.id/*",
      "zone_name": "desalambanggelun.id"
    }
  ]
}
